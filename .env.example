# Supabase project REST API credentials (not used for direct DB access in this app; optional).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Postgres connection string used by Drizzle ORM (server-only, never expose to the client).
# From Supabase dashboard: Project Settings -> Database -> Connection String -> URI.
# Recommended: "Transaction pooler" connection string (port 6543) for serverless/Vercel deployments.
# Example: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
SUPABASE_CONNECTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

BETTER_AUTH_SECRET=

# 배포 후 실제 배포 주소 들어감
BETTER_AUTH_URL=